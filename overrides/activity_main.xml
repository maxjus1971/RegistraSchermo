<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111827"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">
        <ImageView
            android:layout_width="78dp"
            android:layout_height="78dp"
            android:contentDescription="Registrazione schermo"
            android:src="@drawable/ic_record" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:text="RegistraSchermo"
            android:textColor="#FFFFFF"
            android:textSize="27sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Video dello schermo + audio interno.\nIl microfono non viene utilizzato."
            android:textColor="#CBD5E1"
            android:textSize="16sp" />
        <Button
            android:id="@+id/startButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:padding="12dp"
            android:text="Avvia registrazione" />
        <Button
            android:id="@+id/pauseButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:enabled="false"
            android:padding="12dp"
            android:text="Pausa" />
        <Button
            android:id="@+id/stopButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:enabled="false"
            android:padding="12dp"
            android:text="Ferma e salva" />
        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="Pronto per registrare"
            android:textColor="#F8FAFC"
            android:textSize="20sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="I video sono salvati in Filmati/RegistraSchermo.\nDurante la registrazione, scorri dall’alto per aprire le notifiche: lì trovi REC / IN PAUSA, Pausa / Riprendi e Stop.\nNon c’è più una barra flottante nera. La tendina delle notifiche può però essere visibile nel filmato mentre la apri."
            android:textColor="#94A3B8"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>